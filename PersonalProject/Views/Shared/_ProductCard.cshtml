@model Product

<div style="border:1px solid #333; padding:10px; width:220px;">
    <img src="@Model.Photos[0].URL" alt="@Model.Title" style="width:100%; height:120px; object-fit:cover;" />
    <div><strong>@Model.Title</strong></div>
    <div>@Model.OEM</div>
    <div>@Model.Brand.Name</div>
    <div>@Model.Price.ToString("C")</div>
</div>
